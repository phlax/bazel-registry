load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "sq",
    crate_root = "src/main.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    crate_features = [
        "crypto-rust",
        "allow-experimental-crypto",
        "allow-variable-time-crypto",
    ],
    deps = [
        "@sequoia_sq_crate_index//:sequoia-sq",
    ],
)
