module(
    name = "sq",
    version = "1.4.0.envoy",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_rust", version = "0.69.0.envoy")
bazel_dep(name = "capnp-cpp", version = "1.4.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.85.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "sequoia-openpgp",
    crate_features = [
        "crypto-rust",
        "allow-experimental-crypto",
        "allow-variable-time-crypto",
    ],
)

# `sequoia-ipc` and `sequoia-keystore` compile `.capnp` schemas in their
# `build.rs` via the `capnpc` crate, which always shells out to a `capnp`
# found on `$PATH` unless told otherwise (`capnpc::CompilerCommand` has no
# way to do that via an environment variable). Patch both `build.rs` files
# to honour a `CAPNP` env var pointing at the hermetic `capnp-cpp` tool
# instead of relying on a host-installed binary.
crate.annotation(
    crate = "sequoia-ipc",
    build_script_env = {"CAPNP": "$(execpath @@capnp-cpp+//src/capnp:capnp_tool)"},
    build_script_tools = ["@@capnp-cpp+//src/capnp:capnp_tool"],
    patch_args = ["-p1"],
    patches = ["//crate-patches:sequoia-ipc-hermetic-capnp.patch"],
)
crate.annotation(
    crate = "sequoia-keystore",
    build_script_env = {"CAPNP": "$(execpath @@capnp-cpp+//src/capnp:capnp_tool)"},
    build_script_tools = ["@@capnp-cpp+//src/capnp:capnp_tool"],
    patch_args = ["-p1"],
    patches = ["//crate-patches:sequoia-keystore-hermetic-capnp.patch"],
)

# `libsqlite3-sys` (via `rusqlite`) defaults to looking for a system sqlite3
# via `pkg-config`. Force it to compile its bundled sqlite3 amalgamation
# instead so the build stays hermetic.
crate.annotation(
    crate = "rusqlite",
    crate_features = ["bundled"],
)

# `sequoia-keystore-backend`'s always-compiled `test_framework` module bakes
# an absolute, build-script-sandbox-specific path into `OUT_DIR` and reads it
# back via `include_bytes!` when the crate itself is compiled. Under Bazel
# each action gets its own sandbox, so that absolute path doesn't survive
# between the build script action and the compile action. Patch it to write
# a path relative to `CARGO_MANIFEST_DIR`, which rules_rust sets correctly
# for every action.
crate.annotation(
    crate = "sequoia-keystore-backend",
    patch_args = ["-p1"],
    patches = ["//crate-patches:sequoia-keystore-backend-hermetic-paths.patch"],
)
# Keep sq's network functionality, but force the HTTP and DNSSEC stacks away
# from native TLS/OpenSSL and onto Rustls with Ring.  The Rustls ecosystem
# defaults to aws-lc-rs in several crates, so disable defaults where needed to
# avoid its cmake/go build requirements.
crate.annotation(
    crate = "sequoia-net",
    patch_args = ["-p1"],
    patches = ["//crate-patches:sequoia-net-rustls.patch"],
)
crate.annotation(
    crate = "rustls",
    default_features = False,
    crate_features = ["ring", "std", "tls12"],
)
crate.annotation(
    crate = "hyper-rustls",
    default_features = False,
    crate_features = ["http1", "http2", "ring", "tls12", "webpki-tokio"],
)
crate.annotation(
    crate = "tokio-rustls",
    default_features = False,
    crate_features = ["ring", "tls12"],
)
crate.annotation(
    crate = "rustls-webpki",
    default_features = False,
    crate_features = ["ring", "std"],
)

crate.from_cargo(
    name = "sequoia_sq_crate_index",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "sequoia_sq_crate_index")

register_toolchains("//toolchains:from_source")
