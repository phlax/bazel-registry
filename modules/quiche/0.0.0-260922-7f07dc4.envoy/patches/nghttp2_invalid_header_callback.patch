+#if NGHTTP2_VERSION_NUM >= 0x014300 && NGHTTP2_VERSION_NUM < 0x014500
+constexpr absl::string_view kInvalidHttpHeaderErrorPrefix =
+    "Invalid HTTP header field was received: frame type: ";
+constexpr absl::string_view kInvalidHttpHeaderStreamPrefix = ", stream: ";
+constexpr absl::string_view kInvalidHttpHeaderNamePrefix = ", name: [";
+constexpr absl::string_view kInvalidHttpHeaderValuePrefix = "], value: [";
+
+bool ParseInvalidHttpHeaderError(absl::string_view message,
+                                 Http2StreamId* stream_id,
+                                 absl::string_view* header_name) {
+  if (!absl::StartsWith(message, kInvalidHttpHeaderErrorPrefix)) {
+    return false;
+  }
+
+  const size_t stream_begin = message.find(kInvalidHttpHeaderStreamPrefix);
+  if (stream_begin == absl::string_view::npos) {
+    return false;
+  }
+  const size_t stream_value_begin =
+      stream_begin + kInvalidHttpHeaderStreamPrefix.size();
+
+  const size_t name_begin =
+      message.find(kInvalidHttpHeaderNamePrefix, stream_value_begin);
+  if (name_begin == absl::string_view::npos) {
+    return false;
+  }
+
+  if (!absl::SimpleAtoi(
+          message.substr(stream_value_begin, name_begin - stream_value_begin),
+          stream_id)) {
+    return false;
+  }
+
+  const size_t header_name_begin =
+      name_begin + kInvalidHttpHeaderNamePrefix.size();
+  const size_t value_begin =
+      message.find(kInvalidHttpHeaderValuePrefix, header_name_begin);
+  if (value_begin == absl::string_view::npos) {
+    return false;
+  }
+
+  *header_name =
+      message.substr(header_name_begin, value_begin - header_name_begin);
+  return true;
+}
+#endif
