+int OnInvalidHeader(nghttp2_session* /* session */, const nghttp2_frame* frame,
+                    nghttp2_rcbuf* name, nghttp2_rcbuf* value,
+                    uint8_t /*flags*/, void* /*user_data*/) {
+  QUICHE_VLOG(1) << "callbacks::OnInvalidHeader(stream_id="
+                 << frame->hd.stream_id << ", name=["
+                 << absl::CEscape(ToStringView(name)) << "], value=["
+                 << absl::CEscape(ToStringView(value)) << "])";
+  // Treat invalid header fields as a stream error. nghttp2 >= 1.67 silently
+  // ignores them when no invalid-header callback is registered; returning
+  // NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE causes nghttp2 to RST_STREAM and
+  // invoke on_invalid_frame_recv_callback, matching pre-1.67 default
+  // behavior and OgHttp2Adapter.
+  return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE;
+}
