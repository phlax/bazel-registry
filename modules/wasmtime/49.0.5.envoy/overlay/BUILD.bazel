load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_library")

licenses(["notice"])  # Apache 2

# Keep these C API features aligned with the wasmtime crate.spec in MODULE.bazel.
# runtime/std are unconditional dependencies; gc-drc provides the GC collector.
_C_API_FEATURES = [
    "cranelift",
    "gc",
    "gc-drc",
]

_C_API_DEPS = [
    "@cu//:anyhow",
    "@cu//:log",
    "@cu//:once_cell",
    "@cu//:tracing",
    "@cu//:wasmtime",
]

genrule(
    name = "wasmtime_conf_h",
    srcs = ["crates/c-api/include/wasmtime/conf.h.in"],
    outs = ["crates/c-api/include/wasmtime/conf.h"],
    cmd = """
        set --
        for feature in %s; do
            set -- "$$@" -e "s/^#cmakedefine WASMTIME_FEATURE_$${feature}$$/#define WASMTIME_FEATURE_$${feature}/"
        done
        sed "$$@" -e 's/^#cmakedefine \\(WASMTIME_FEATURE_[A-Z0-9_]*\\)$$/\\/* #undef \\1 *\\//' $(<) > $@
    """ % " ".join([feature.upper().replace("-", "_") for feature in _C_API_FEATURES]),
)

cc_library(
    name = "wasmtime_lib",
    hdrs = glob([
        "crates/c-api/include/**/*.h",
        "crates/c-api/include/**/*.hh",
    ]) + [":wasmtime_conf_h"],
    includes = ["crates/c-api/include"],
    deps = [
        ":rust_c_api",
    ],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "wasmtime_test",
    srcs = ["wasmtime_test.cc"],
    deps = [":wasmtime_lib"],
)

genrule(
    name = "prefixed_wasmtime_c_api_headers",
    srcs = [
        "crates/c-api/include/wasm.h",
    ],
    outs = [
        "crates/c-api/include/prefixed_wasm.h",
    ],
    cmd = """
        sed -e 's/\\([[:space:](*,]\\)wasm_/\\1wasmtime_wasm_/g' \
            -e 's/^wasm_/wasmtime_wasm_/g' \
        $(<) >$@
    """,
    visibility = ["//visibility:public"],
)

genrule(
    name = "prefixed_wasmtime_c_api_lib",
    srcs = [
        ":rust_c_api",
    ],
    outs = [
        "prefixed_wasmtime_c_api.a",
    ],
    cmd = """
        for symbol in $$(nm -P $(<) 2>/dev/null | grep -E ^_?wasm_ | cut -d" " -f1); do
            echo $$symbol | sed -r 's/^(_?)(wasm_[a-z0-9_]+)$$/\\1\\2 \\1wasmtime_\\2/' >>$(GENDIR)/prefixed_symbols
        done
        objcopy --redefine-syms=$(GENDIR)/prefixed_symbols $(<) $@
        """,
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "prefixed_wasmtime_lib",
    srcs = [
        ":prefixed_wasmtime_c_api_lib",
    ],
    hdrs = [
        ":prefixed_wasmtime_c_api_headers",
    ],
    linkstatic = 1,
    # Note: prefixed_wasmtime_lib is Linux-only due to objcopy dependency
    # For cross-platform support, use wasmtime_lib instead
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    # The rewritten rlib no longer embeds its Rust dependencies.
    deps = _C_API_DEPS,
)

# Use an rlib so rules_rust supplies std/compiler_builtins through the toolchain.
# A staticlib embeds them, causing duplicate symbols when consumers (e.g. Envoy's
# built-in Hickory DNS module) link another Rust staticlib into the same binary.
rust_library(
    name = "rust_c_api",
    srcs = glob(["crates/c-api/src/**/*.rs"]),
    crate_features = _C_API_FEATURES,
    crate_root = "crates/c-api/src/lib.rs",
    edition = "2024",
    aliases = {
        "@cu//:wasmtime-internal-c-api-macros": "wasmtime_c_api_macros",
    },
    proc_macro_deps = [
        "@cu//:wasmtime-internal-c-api-macros",
    ],
    deps = _C_API_DEPS,
    visibility = ["//visibility:public"],
)
